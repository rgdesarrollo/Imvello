<UserControl x:Class="Imvello.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBrush}">
    <UserControl.Resources>
        <Style x:Key="EventItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{DynamicResource PaneBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,1">
                <StackPanel Orientation="Horizontal" Margin="10,8">
                    <Button Style="{StaticResource PrimaryButton}" Height="28" Padding="12,0" Click="NewEvent_Click"
                            Content="{DynamicResource Calendar.NewEvent}"/>
                    <Button Style="{StaticResource SecondaryButton}" Height="28" Padding="12,0" Margin="8,0,0,0" Click="Today_Click"
                            Content="{DynamicResource Calendar.Today}"/>
                </StackPanel>
            </Border>
            <Viewbox Grid.Row="1" Stretch="Uniform" MaxWidth="300" Margin="10,10,10,4">
                <Calendar x:Name="MonthCalendar" SelectionMode="SingleDate" SelectedDatesChanged="MonthCalendar_SelectedDatesChanged"/>
            </Viewbox>
            <TextBlock x:Name="DayHeading" Grid.Row="2" Margin="12,8,12,4" FontWeight="SemiBold" FontSize="13"/>
            <Grid Grid.Row="3">
                <ListBox x:Name="EventList" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource EventItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="EventList_SelectionChanged"/>
                <TextBlock x:Name="NoEventsText" Text="{DynamicResource Calendar.NoEvents}" Margin="12,8" Foreground="{DynamicResource SubtleTextBrush}"
                           FontSize="12" Visibility="Collapsed"/>
            </Grid>
            <TextBlock x:Name="CountText" Grid.Row="4" Margin="10,6" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11"/>
        </Grid>

        <Grid Grid.Column="1">
            <TextBlock x:Name="HintText" Text="{DynamicResource Calendar.SelectHint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource SubtleTextBrush}" FontSize="13" TextWrapping="Wrap" MaxWidth="300" TextAlignment="Center"/>
            <ScrollViewer x:Name="EditorPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="28,18">
                    <TextBlock x:Name="EventHeading" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="560" HorizontalAlignment="Left"/>

                    <Grid Margin="0,18,0,0" MaxWidth="560" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{DynamicResource Calendar.Title}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,10,12,0"/>
                        <TextBox x:Name="TitleBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}" Height="28" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="1" Text="{DynamicResource Calendar.Location}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,10,12,0"/>
                        <TextBox x:Name="LocationBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}" Height="28" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="2" Text="{DynamicResource Calendar.Date}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,10,12,0"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <DatePicker x:Name="DateBox" Width="150" Height="28" SelectedDateFormat="Short"/>
                            <CheckBox x:Name="AllDayBox" Content="{DynamicResource Calendar.AllDay}" VerticalAlignment="Center" Margin="14,0,0,0"
                                      Checked="AllDayBox_Changed" Unchecked="AllDayBox_Changed"/>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Text="{DynamicResource Calendar.Start}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,10,12,0"/>
                        <StackPanel x:Name="TimePanel" Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBox x:Name="StartBox" Style="{StaticResource FieldBox}" Height="28" Width="80"/>
                            <TextBlock Text="{DynamicResource Calendar.End}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="14,0,8,0"/>
                            <TextBox x:Name="EndBox" Style="{StaticResource FieldBox}" Height="28" Width="80"/>
                        </StackPanel>
                        <TextBlock Grid.Row="4" Text="{DynamicResource Calendar.Notes}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" VerticalAlignment="Top" Margin="0,10,12,0"/>
                        <TextBox x:Name="NotesBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBox}" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="100" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Padding="20,6" Click="Save_Click" Content="{DynamicResource Calendar.Save}"/>
                        <Button x:Name="DeleteButton" Style="{StaticResource SecondaryButton}" Padding="16,6" Margin="8,0,0,0" Click="Delete_Click" Content="{DynamicResource Calendar.Delete}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
