<UserControl x:Class="Imvello.Views.ReadingPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{DynamicResource WindowBrush}">
    <Grid>
        <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="&#xE715;" Style="{StaticResource Icon}" FontSize="56" Foreground="{DynamicResource ControlBorderBrush}"/>
            <TextBlock x:Name="EmptyText" Text="{DynamicResource Main.SelectItemToRead}" FontSize="15" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
            <TextBlock Text="{DynamicResource Main.NothingSelected}" FontSize="12" Foreground="{DynamicResource PlaceholderBrush}" Margin="0,4,0,0" HorizontalAlignment="Center" x:Name="EmptySub"/>
        </StackPanel>

        <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <ProgressBar IsIndeterminate="True" Width="160" Height="4"/>
            <TextBlock Text="{DynamicResource Main.LoadingMessage}" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel x:Name="ErrorPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="420">
            <TextBlock Text="&#xE783;" Style="{StaticResource Icon}" FontSize="40" Foreground="{DynamicResource DangerBrush}"/>
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,10,0,0"/>
        </StackPanel>

        <Grid x:Name="MessagePanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="16,12,16,6">
                <TextBlock x:Name="SubjectText" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Avatar" Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top" Margin="0,0,12,0">
                        <TextBlock x:Name="AvatarText" Foreground="White" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="FromText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ToText" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock x:Name="CcText" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource FlatButton}" Click="Reply_Click" ToolTip="{DynamicResource Main.Reply}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE97A;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{DynamicResource Main.Reply}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FlatButton}" Click="ReplyAll_Click" ToolTip="{DynamicResource Main.ReplyAll}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEE0A;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{DynamicResource Main.ReplyAll}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource FlatButton}" Click="Forward_Click" ToolTip="{DynamicResource Main.Forward}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{DynamicResource Main.Forward}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="DateText" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Right" Margin="0,6,6,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <ItemsControl Grid.Row="1" x:Name="AttachmentList" Margin="66,0,16,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="Attachment_Click" MouseRightButtonUp="Attachment_RightClick" Margin="0,0,6,6" Cursor="Hand" ToolTip="{DynamicResource Main.AttachmentToolTip}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,5" Background="{DynamicResource ControlBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="18" Foreground="{DynamicResource AccentBrush}"/>
                                            <StackPanel Margin="8,0,0,0">
                                                <TextBlock Text="{Binding FileName}" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Size, Converter={StaticResource SizeConv}}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="2" x:Name="ImagesBar" Background="{DynamicResource WarningBackgroundBrush}" Padding="12,6" Visibility="Collapsed" Margin="16,0,16,4" CornerRadius="4">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{DynamicResource Main.DownloadPictures}" Style="{StaticResource FlatButton}" Foreground="{DynamicResource AccentBrush}" Click="DownloadPictures_Click"/>
                    <TextBlock Text="{DynamicResource Main.ImagesBlocked}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <wv2:WebView2 x:Name="Browser"/>
                    <TextBox x:Name="FallbackText" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap" Padding="16,10" FontSize="13"
                             VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
