<UserControl x:Class="Imvello.Views.ContactsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Imvello.Views"
             Background="{DynamicResource WindowBrush}">
    <UserControl.Resources>
        <Style x:Key="ContactItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{DynamicResource PaneBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,1">
                <StackPanel Orientation="Horizontal" Margin="10,8">
                    <TextBox x:Name="SearchBox" Style="{StaticResource FieldBox}" Height="28" Width="168" TextChanged="SearchBox_TextChanged"
                             ToolTip="{DynamicResource Contacts.SearchToolTip}"/>
                    <Button Style="{StaticResource PrimaryButton}" Height="28" Padding="12,0" Margin="8,0,0,0" Click="NewContact_Click"
                            Content="{DynamicResource Contacts.NewContact}"/>
                </StackPanel>
            </Border>
            <ListBox x:Name="ContactList" Grid.Row="1" BorderThickness="0" ItemContainerStyle="{StaticResource ContactItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="ContactList_SelectionChanged" MouseDoubleClick="ContactList_DoubleClick"/>
            <TextBlock x:Name="CountText" Grid.Row="2" Margin="10,6" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11"/>
        </Grid>

        <Grid Grid.Column="1">
            <TextBlock x:Name="HintText" Text="{DynamicResource Contacts.SelectHint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource SubtleTextBrush}" FontSize="13" TextWrapping="Wrap" MaxWidth="300" TextAlignment="Center"/>
            <ScrollViewer x:Name="EditorPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="28,18">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="BigAvatar" Width="64" Height="64" CornerRadius="32">
                            <TextBlock x:Name="BigInitials" FontSize="22" Foreground="White" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock x:Name="NameHeading" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                            <TextBlock x:Name="StatsText" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Margin="0,18,0,0" MaxWidth="560" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Contacts.Name}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,10,12,0"/>
                        <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}" Height="28" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Contacts.Email}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,10,12,0"/>
                        <TextBox x:Name="EmailBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}" Height="28" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Contacts.Phone}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,10,12,0"/>
                        <TextBox x:Name="PhoneBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}" Height="28" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Contacts.Company}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,10,12,0"/>
                        <TextBox x:Name="CompanyBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}" Height="28" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Contacts.Notes}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" VerticalAlignment="Top" Margin="0,10,12,0"/>
                        <TextBox x:Name="NotesBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBox}" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="100" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Padding="20,6" Click="Save_Click" Content="{DynamicResource Contacts.Save}"/>
                        <Button x:Name="SendButton" Style="{StaticResource SecondaryButton}" Padding="16,6" Margin="8,0,0,0" Click="Send_Click" Content="{DynamicResource Contacts.SendEmail}"/>
                        <Button x:Name="DeleteButton" Style="{StaticResource SecondaryButton}" Padding="16,6" Margin="8,0,0,0" Click="Delete_Click" Content="{DynamicResource Contacts.Delete}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
