<Window x:Class="Imvello.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Imvello.Views"
        Title="{DynamicResource Main.WindowTitleInbox}" Style="{StaticResource ImvelloWindow}"
        Width="1400" Height="850" MinWidth="900" MinHeight="560" WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static v:MainWindow.NewMailCommand}"/>
        <KeyBinding Key="R" Modifiers="Control" Command="{x:Static v:MainWindow.ReplyCommand}"/>
        <KeyBinding Key="R" Modifiers="Control+Shift" Command="{x:Static v:MainWindow.ReplyAllCommand}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static v:MainWindow.ForwardCommand}"/>
        <KeyBinding Key="Q" Modifiers="Control" Command="{x:Static v:MainWindow.MarkReadCommand}"/>
        <KeyBinding Key="U" Modifiers="Control" Command="{x:Static v:MainWindow.MarkUnreadCommand}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{x:Static v:MainWindow.SearchCommand}"/>
        <KeyBinding Key="F3" Command="{x:Static v:MainWindow.SearchCommand}"/>
        <KeyBinding Key="F9" Command="{x:Static v:MainWindow.SendReceiveCommand}"/>
        <KeyBinding Key="Delete" Modifiers="Control" Command="{x:Static v:MainWindow.DeleteCommand}"/>
        <KeyBinding Key="Backspace" Command="{x:Static v:MainWindow.ArchiveCommand}"/>
        <KeyBinding Key="V" Modifiers="Control+Shift" Command="{x:Static v:MainWindow.MoveCommand}"/>
        <KeyBinding Key="J" Modifiers="Control+Alt" Command="{x:Static v:MainWindow.JunkCommand}"/>
        <KeyBinding Key="P" Modifiers="Control" Command="{x:Static v:MainWindow.PrintCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource AccentBrush}" Height="44">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="&#xE715;" Style="{StaticResource Icon}" Foreground="{DynamicResource OnAccentBrush}" FontSize="18"/>
                    <TextBlock Text="Imvello" Foreground="{DynamicResource OnAccentBrush}" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Grid x:Name="SearchArea" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="SearchBox_KeyDown" ToolTip="{DynamicResource Main.SearchToolTip}"/>
                    <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Right" Margin="0,0,4,0" Click="ClearSearch_Click"
                            Visibility="{Binding IsSearchActive, Converter={StaticResource BoolToVis}}" ToolTip="{DynamicResource Main.CloseSearch}">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="12"/>
                    </Button>
                </Grid>
                <StackPanel x:Name="SearchScopePanel" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <ComboBox x:Name="SearchScope" Width="150" Height="26" VerticalContentAlignment="Center" SelectedIndex="0"
                              SelectionChanged="SearchScope_Changed">
                        <ComboBoxItem Content="{DynamicResource Main.AllMailboxes}"/>
                        <ComboBoxItem Content="{DynamicResource Main.CurrentFolder}"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <v:RibbonBar Grid.Row="1" x:Name="Ribbon"/>

        <Grid Grid.Row="2" x:Name="ContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition x:Name="FolderColumn" Width="240" MinWidth="0"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource PaneBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,6,0,0">
                    <RadioButton x:Name="NavMail" Style="{StaticResource AppBarButton}" GroupName="nav" IsChecked="True" ToolTip="{DynamicResource Main.Mail}" Click="NavMail_Click">
                        <TextBlock Text="&#xE715;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource AccentBrush}"/>
                    </RadioButton>
                    <RadioButton x:Name="NavCalendar" Style="{StaticResource AppBarButton}" GroupName="nav" ToolTip="{DynamicResource Main.Calendar}" Click="NavCalendar_Click">
                        <TextBlock Text="&#xE787;" Style="{StaticResource Icon}" FontSize="20"/>
                    </RadioButton>
                    <RadioButton x:Name="NavPeople" Style="{StaticResource AppBarButton}" GroupName="nav" ToolTip="{DynamicResource Main.People}" Click="NavPeople_Click">
                        <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" FontSize="20"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource AppBarButton}" GroupName="nav" ToolTip="{DynamicResource Main.Tasks}" Click="NotAvailable_Click">
                        <TextBlock Text="&#xE9D5;" Style="{StaticResource Icon}" FontSize="20"/>
                    </RadioButton>
                </StackPanel>
            </Border>

            <v:FolderPane Grid.Column="1" x:Name="FolderPaneView"/>
            <GridSplitter Grid.Column="2" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}"
                          ResizeBehavior="PreviousAndNext" x:Name="FolderSplitter"/>

            <Grid Grid.Column="3" x:Name="ListReadingGrid">
                <v:MessageListView x:Name="MessageListView"/>
                <GridSplitter x:Name="ReadingSplitter" Background="{DynamicResource BorderBrush}"/>
                <v:ReadingPane x:Name="ReadingPaneView"/>
            </Grid>

            <v:WelcomeView Grid.Column="1" Grid.ColumnSpan="3" x:Name="WelcomeView"
                           Visibility="{Binding HasAccounts, Converter={StaticResource InverseBoolToVis}}"/>

            <v:CalendarView Grid.Column="1" Grid.ColumnSpan="3" x:Name="CalendarModule" Visibility="Collapsed"/>
            <v:ContactsView Grid.Column="1" Grid.ColumnSpan="3" x:Name="ContactsModule" Visibility="Collapsed"/>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource PaneBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ItemsText}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ProgressBar Width="120" Height="8" Margin="0,0,10,0" Minimum="0" Maximum="1"
                                 Value="{Binding Progress, TargetNullValue=0}" Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" MaxWidth="700" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>

        <v:Backstage Grid.Row="0" Grid.RowSpan="4" x:Name="BackstageView" Visibility="Collapsed"/>
    </Grid>
</Window>
