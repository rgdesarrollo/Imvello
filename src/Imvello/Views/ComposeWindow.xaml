<Window x:Class="Imvello.Views.ComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{DynamicResource Dialogs.NewComposeTitle}" Style="{StaticResource ImvelloWindow}" Width="960" Height="760" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{x:Static ApplicationCommands.Save}" CommandParameter="send"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static ApplicationCommands.Save}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource RibbonBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2,0,0">
                    <TabControl x:Name="Tabs" BorderThickness="0" Background="Transparent" Padding="0" SelectedIndex="0" Height="30">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <TabPanel IsItemsHost="True"/>
                            </ControlTemplate>
                        </TabControl.Template>
                        <TabItem Header="{DynamicResource Dialogs.ComposeTabMessage}" Style="{StaticResource RibbonTab}"/>
                        <TabItem Header="{DynamicResource Dialogs.ComposeTabInsert}" Style="{StaticResource RibbonTab}"/>
                        <TabItem Header="{DynamicResource Dialogs.ComposeTabOptions}" Style="{StaticResource RibbonTab}"/>
                        <TabItem Header="{DynamicResource Dialogs.ComposeTabFormatText}" Style="{StaticResource RibbonTab}"/>
                    </TabControl>
                </StackPanel>
                <Grid Height="92" Margin="4,4,4,2">
                    <StackPanel Orientation="Horizontal" x:Name="MessagePanel">
                        <HeaderedContentControl Header="{DynamicResource Dialogs.Clipboard}" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource Dialogs.Paste}" Tag="&#xE77F;" Style="{StaticResource RibbonLarge}" Click="Exec_Click" CommandParameter="paste"/>
                                <StackPanel VerticalAlignment="Center">
                                    <Button Content="{DynamicResource Dialogs.Cut}" Tag="&#xE8C6;" Style="{StaticResource RibbonSmall}" Click="Exec_Click" CommandParameter="cut"/>
                                    <Button Content="{DynamicResource Dialogs.Copy}" Tag="&#xE8C8;" Style="{StaticResource RibbonSmall}" Click="Exec_Click" CommandParameter="copy"/>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="{DynamicResource Dialogs.BasicText}" Style="{StaticResource RibbonGroup}">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ComboBox x:Name="FontBox" Width="130" IsEditable="False" SelectionChanged="FontBox_Changed"/>
                                    <ComboBox x:Name="SizeBox" Width="50" Margin="4,0,0,0" SelectionChanged="SizeBox_Changed"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource FlatButton}" Click="Exec_Click" CommandParameter="bold" ToolTip="{DynamicResource Dialogs.BoldToolTip}"><TextBlock Text="&#xE8DD;" Style="{StaticResource Icon}" FontSize="14"/></Button>
                                    <Button Style="{StaticResource FlatButton}" Click="Exec_Click" CommandParameter="italic" ToolTip="{DynamicResource Dialogs.ItalicToolTip}"><TextBlock Text="&#xE8DB;" Style="{StaticResource Icon}" FontSize="14"/></Button>
                                    <Button Style="{StaticResource FlatButton}" Click="Exec_Click" CommandParameter="underline" ToolTip="{DynamicResource Dialogs.UnderlineToolTip}"><TextBlock Text="&#xE8DC;" Style="{StaticResource Icon}" FontSize="14"/></Button>
                                    <Button Style="{StaticResource FlatButton}" Click="Color_Click" Tag="#C50F1F" ToolTip="{DynamicResource Dialogs.FontColorToolTip}"><TextBlock Text="&#xE8D3;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource DangerBrush}"/></Button>
                                    <Button Style="{StaticResource FlatButton}" Click="Highlight_Click" ToolTip="{DynamicResource Dialogs.HighlightColorToolTip}"><TextBlock Text="&#xE7E6;" Style="{StaticResource Icon}" FontSize="14" Foreground="#E0B000"/></Button>
                                    <Button Style="{StaticResource FlatButton}" Click="Exec_Click" CommandParameter="insertUnorderedList" ToolTip="{DynamicResource Dialogs.BulletsToolTip}"><TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" FontSize="14"/></Button>
                                    <Button Style="{StaticResource FlatButton}" Click="Exec_Click" CommandParameter="insertOrderedList" ToolTip="{DynamicResource Dialogs.NumberingToolTip}"><TextBlock Text="&#xE9D5;" Style="{StaticResource Icon}" FontSize="14"/></Button>
                                    <Button Style="{StaticResource FlatButton}" Click="Exec_Click" CommandParameter="justifyLeft" ToolTip="{DynamicResource Dialogs.AlignLeftToolTip}"><TextBlock Text="&#xE8E4;" Style="{StaticResource Icon}" FontSize="14"/></Button>
                                    <Button Style="{StaticResource FlatButton}" Click="Exec_Click" CommandParameter="justifyCenter" ToolTip="{DynamicResource Dialogs.CenterToolTip}"><TextBlock Text="&#xE8E3;" Style="{StaticResource Icon}" FontSize="14"/></Button>
                                    <Button Style="{StaticResource FlatButton}" Click="Exec_Click" CommandParameter="justifyRight" ToolTip="{DynamicResource Dialogs.AlignRightToolTip}"><TextBlock Text="&#xE8E2;" Style="{StaticResource Icon}" FontSize="14"/></Button>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="{DynamicResource Dialogs.Names}" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource Dialogs.CheckNames}" Tag="&#xE8D4;" Style="{StaticResource RibbonLarge}" Click="CheckNames_Click"/>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="{DynamicResource Dialogs.Include}" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource Dialogs.AttachFile}" Tag="&#xE723;" Style="{StaticResource RibbonLarge}" Click="Attach_Click"/>
                                <Button Content="{DynamicResource Dialogs.Signature}" Tag="&#xE70F;" Style="{StaticResource RibbonLarge}" Click="Signature_Click"/>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="{DynamicResource Dialogs.Tags}" Style="{StaticResource RibbonGroup}">
                            <StackPanel VerticalAlignment="Center">
                                <ToggleButton x:Name="HighToggle" Content="{DynamicResource Dialogs.HighImportance}" Tag="&#xE8C9;" Style="{StaticResource RibbonSmall}" Click="Importance_Click"/>
                                <ToggleButton x:Name="LowToggle" Content="{DynamicResource Dialogs.LowImportance}" Tag="&#xE74B;" Style="{StaticResource RibbonSmall}" Click="Importance_Click"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" x:Name="InsertPanel" Visibility="Collapsed">
                        <HeaderedContentControl Header="{DynamicResource Dialogs.Include}" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource Dialogs.AttachFile}" Tag="&#xE723;" Style="{StaticResource RibbonLarge}" Click="Attach_Click"/>
                                <Button Content="{DynamicResource Dialogs.Signature}" Tag="&#xE70F;" Style="{StaticResource RibbonLarge}" Click="Signature_Click"/>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="{DynamicResource Dialogs.Illustrations}" Style="{StaticResource RibbonGroup}">
                            <Button Content="{DynamicResource Dialogs.Pictures}" Tag="&#xEB9F;" Style="{StaticResource RibbonLarge}" Click="Picture_Click"/>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="{DynamicResource Dialogs.Links}" Style="{StaticResource RibbonGroup}">
                            <Button Content="{DynamicResource Dialogs.Link}" Tag="&#xE71B;" Style="{StaticResource RibbonLarge}" Click="Link_Click"/>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="{DynamicResource Dialogs.Symbols}" Style="{StaticResource RibbonGroup}">
                            <Button Content="{DynamicResource Dialogs.HorizontalLine}" Tag="&#xE738;" Style="{StaticResource RibbonLarge}" Click="Exec_Click" CommandParameter="insertHorizontalRule"/>
                        </HeaderedContentControl>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" x:Name="OptionsPanel" Visibility="Collapsed">
                        <HeaderedContentControl Header="{DynamicResource Dialogs.ShowFields}" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="BccToggle" Content="{DynamicResource Dialogs.Bcc}" Tag="&#xE716;" Style="{StaticResource RibbonLarge}" Click="BccToggle_Click"/>
                                <ToggleButton x:Name="FromToggle" Content="{DynamicResource Dialogs.From}" Tag="&#xE77B;" Style="{StaticResource RibbonLarge}" IsChecked="True" Click="FromToggle_Click"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" x:Name="FormatPanel" Visibility="Collapsed">
                        <HeaderedContentControl Header="{DynamicResource Dialogs.Font}" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource FlatButton}" Click="Exec_Click" CommandParameter="strikeThrough" ToolTip="{DynamicResource Dialogs.StrikethroughToolTip}"><TextBlock Text="&#xEDE0;" Style="{StaticResource Icon}" FontSize="14"/></Button>
                                <Button Style="{StaticResource FlatButton}" Click="Exec_Click" CommandParameter="subscript" ToolTip="{DynamicResource Dialogs.SubscriptToolTip}"><TextBlock Text="x&#x2082;" FontSize="14"/></Button>
                                <Button Style="{StaticResource FlatButton}" Click="Exec_Click" CommandParameter="superscript" ToolTip="{DynamicResource Dialogs.SuperscriptToolTip}"><TextBlock Text="x&#xB2;" FontSize="14"/></Button>
                                <Button Style="{StaticResource FlatButton}" Click="Exec_Click" CommandParameter="removeFormat" ToolTip="{DynamicResource Dialogs.ClearFormattingToolTip}"><TextBlock Text="&#xE894;" Style="{StaticResource Icon}" FontSize="14"/></Button>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="{DynamicResource Dialogs.Paragraph}" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource FlatButton}" Click="Exec_Click" CommandParameter="outdent" ToolTip="{DynamicResource Dialogs.DecreaseIndentToolTip}"><TextBlock Text="&#xE290;" Style="{StaticResource Icon}" FontSize="14"/></Button>
                                <Button Style="{StaticResource FlatButton}" Click="Exec_Click" CommandParameter="indent" ToolTip="{DynamicResource Dialogs.IncreaseIndentToolTip}"><TextBlock Text="&#xE291;" Style="{StaticResource Icon}" FontSize="14"/></Button>
                                <Button Style="{StaticResource FlatButton}" Click="Exec_Click" CommandParameter="undo" ToolTip="{DynamicResource Dialogs.UndoToolTip}"><TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" FontSize="14"/></Button>
                                <Button Style="{StaticResource FlatButton}" Click="Exec_Click" CommandParameter="redo" ToolTip="{DynamicResource Dialogs.RedoToolTip}"><TextBlock Text="&#xE7A6;" Style="{StaticResource Icon}" FontSize="14"/></Button>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="10,10,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="SendButton" Style="{StaticResource PrimaryButton}" Width="72" Margin="0,0,10,0" VerticalAlignment="Stretch" Click="Send_Click" ToolTip="{DynamicResource Dialogs.SendToolTip}">
                <StackPanel>
                    <TextBlock Text="&#xE724;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource OnAccentBrush}"/>
                    <TextBlock Text="{DynamicResource Dialogs.Send}" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Width="64">
                <Button x:Name="FromLabel" Content="{DynamicResource Dialogs.From}" Style="{StaticResource SecondaryButton}" Padding="0,3" Height="28" Margin="0,0,0,4" IsHitTestVisible="False"/>
                <Button Content="{DynamicResource Dialogs.ToEllipsis}" Style="{StaticResource SecondaryButton}" Padding="0,3" Height="28" Margin="0,0,0,4" Click="CheckNames_Click"/>
                <Button Content="{DynamicResource Dialogs.CcEllipsis}" Style="{StaticResource SecondaryButton}" Padding="0,3" Height="28" Margin="0,0,0,4" Click="CheckNames_Click"/>
                <Button x:Name="BccLabel" Content="{DynamicResource Dialogs.BccEllipsis}" Style="{StaticResource SecondaryButton}" Padding="0,3" Height="28" Margin="0,0,0,4" Visibility="Collapsed" Click="CheckNames_Click"/>
                <TextBlock Text="{DynamicResource Dialogs.Subject}" Height="28" Padding="6,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="6,0,0,0">
                <ComboBox x:Name="FromBox" Height="28" Margin="0,0,0,4" DisplayMemberPath="Email" VerticalContentAlignment="Center"/>
                <TextBox x:Name="ToBox" Style="{StaticResource FieldBox}" Height="28" Margin="0,0,0,4"/>
                <TextBox x:Name="CcBox" Style="{StaticResource FieldBox}" Height="28" Margin="0,0,0,4"/>
                <TextBox x:Name="BccBox" Style="{StaticResource FieldBox}" Height="28" Margin="0,0,0,4" Visibility="Collapsed"/>
                <TextBox x:Name="SubjectBox" Style="{StaticResource FieldBox}" Height="28" TextChanged="SubjectBox_TextChanged"/>
            </StackPanel>
        </Grid>

        <ItemsControl Grid.Row="2" x:Name="AttachmentList" Margin="92,2,12,4">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4,4,4" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource AccentBrush}"/>
                            <StackPanel Margin="8,0,4,0">
                                <TextBlock Text="{Binding Name}" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}"/>
                            </StackPanel>
                            <Button Style="{StaticResource FlatButton}" Click="RemoveAttachment_Click" ToolTip="{DynamicResource Dialogs.RemoveAttachmentToolTip}" VerticalAlignment="Top">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <wv2:WebView2 x:Name="Editor"/>
                <TextBox x:Name="FallbackEditor" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Padding="12,8" FontSize="14"
                         VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>
                <TextBlock x:Name="BusyText" Text="{DynamicResource Dialogs.PreparingMessage}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
