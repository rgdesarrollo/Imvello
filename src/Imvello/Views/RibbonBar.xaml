<UserControl x:Class="Imvello.Views.RibbonBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Imvello.Views">
    <Border Background="{DynamicResource RibbonBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2,0,0">
                <Button Content="{DynamicResource Main.FileMenu}" Style="{StaticResource FlatButton}" Padding="14,6" Foreground="{DynamicResource OnAccentBrush}" Background="{DynamicResource AccentBrush}"
                        Margin="2,0,6,0" Command="{x:Static v:MainWindow.BackstageCommand}"/>
                <TabControl x:Name="Tabs" BorderThickness="0" Background="Transparent" Padding="0" SelectedIndex="0" Height="30">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <TabPanel IsItemsHost="True"/>
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabItem Header="{DynamicResource Main.Home}" Style="{StaticResource RibbonTab}"/>
                    <TabItem Header="{DynamicResource Main.SendReceiveTab}" Style="{StaticResource RibbonTab}"/>
                    <TabItem Header="{DynamicResource Main.FolderTab}" Style="{StaticResource RibbonTab}"/>
                    <TabItem Header="{DynamicResource Main.ViewTab}" Style="{StaticResource RibbonTab}"/>
                    <TabItem Header="{DynamicResource Main.Help}" Style="{StaticResource RibbonTab}"/>
                </TabControl>
                <ToggleButton x:Name="CollapseToggle" Style="{StaticResource FlatButton}" Margin="12,0,0,0" ToolTip="{DynamicResource Main.CollapseRibbon}" Padding="6,2">
                    <TextBlock Text="&#xE70E;" Style="{StaticResource Icon}" FontSize="11"/>
                </ToggleButton>
            </StackPanel>

            <Grid Height="92" Margin="4,4,4,2" Visibility="{Binding IsChecked, ElementName=CollapseToggle, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel Orientation="Horizontal" x:Name="HomePanel">
                    <HeaderedContentControl Header="{DynamicResource Main.New}" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource Main.NewEmail}" Tag="&#xE710;" Style="{StaticResource RibbonLarge}" Command="{x:Static v:MainWindow.NewMailCommand}" ToolTip="{DynamicResource Main.NewEmailToolTip}"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{DynamicResource Main.Delete}" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel VerticalAlignment="Center">
                                <Button Content="{DynamicResource Main.Ignore}" Tag="&#xE8F8;" Style="{StaticResource RibbonSmall}" Command="{x:Static v:MainWindow.JunkCommand}" ToolTip="{DynamicResource Main.MoveToJunkToolTip}"/>
                                <Button Content="{DynamicResource Main.CleanUp}" Tag="&#xE7A6;" Style="{StaticResource RibbonSmall}" Command="{x:Static v:MainWindow.MarkAllReadCommand}" ToolTip="{DynamicResource Main.MarkAllReadToolTip}"/>
                                <Button Content="{DynamicResource Main.Junk}" Tag="&#xE730;" Style="{StaticResource RibbonSmall}" Command="{x:Static v:MainWindow.JunkCommand}"/>
                            </StackPanel>
                            <Button Content="{DynamicResource Main.Delete}" Tag="&#xE74D;" Style="{StaticResource RibbonLarge}" Command="{x:Static v:MainWindow.DeleteCommand}" ToolTip="{DynamicResource Main.DeleteToolTip}"/>
                            <Button Content="{DynamicResource Main.ArchiveAction}" Tag="&#xE7B8;" Style="{StaticResource RibbonLarge}" Command="{x:Static v:MainWindow.ArchiveCommand}" ToolTip="{DynamicResource Main.ArchiveToolTip}"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{DynamicResource Main.Respond}" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource Main.Reply}" Tag="&#xE97A;" Style="{StaticResource RibbonLarge}" Command="{x:Static v:MainWindow.ReplyCommand}" ToolTip="{DynamicResource Main.ReplyToolTip}"/>
                            <Button Content="{DynamicResource Main.ReplyAll}" Tag="&#xEE0A;" Style="{StaticResource RibbonLarge}" Command="{x:Static v:MainWindow.ReplyAllCommand}" ToolTip="{DynamicResource Main.ReplyAllToolTip}"/>
                            <Button Content="{DynamicResource Main.Forward}" Tag="&#xE72A;" Style="{StaticResource RibbonLarge}" Command="{x:Static v:MainWindow.ForwardCommand}" ToolTip="{DynamicResource Main.ForwardToolTip}"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{DynamicResource Main.Move}" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource Main.Move}" Tag="&#xE8DE;" Style="{StaticResource RibbonLarge}" Command="{x:Static v:MainWindow.MoveCommand}" ToolTip="{DynamicResource Main.MoveToolTip}"/>
                            <StackPanel VerticalAlignment="Center">
                                <Button Content="{DynamicResource Main.SaveAs}" Tag="&#xE74E;" Style="{StaticResource RibbonSmall}" Command="{x:Static v:MainWindow.SaveAsCommand}"/>
                                <Button Content="{DynamicResource Main.Print}" Tag="&#xE749;" Style="{StaticResource RibbonSmall}" Command="{x:Static v:MainWindow.PrintCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{DynamicResource Main.Tags}" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource Main.UnreadRead}" Tag="&#xE8C3;" Style="{StaticResource RibbonLarge}" Command="{x:Static v:MainWindow.ToggleReadCommand}" ToolTip="{DynamicResource Main.ReadUnreadToolTip}"/>
                            <Button Content="{DynamicResource Main.FollowUp}" Tag="&#xE7C1;" Style="{StaticResource RibbonLarge}" Command="{x:Static v:MainWindow.ToggleFlagCommand}" ToolTip="{DynamicResource Main.FlagUnflagToolTip}"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{DynamicResource Main.Find}" Style="{StaticResource RibbonGroup}">
                        <StackPanel VerticalAlignment="Center">
                            <Button Content="{DynamicResource Common.Search}" Tag="&#xE721;" Style="{StaticResource RibbonSmall}" Command="{x:Static v:MainWindow.SearchCommand}"/>
                            <Button Content="{DynamicResource Main.FilterEmail}" Tag="&#xE71C;" Style="{StaticResource RibbonSmall}" Click="FilterMenu_Click"/>
                            <Button Content="{DynamicResource Main.Sort}" Tag="&#xE8CB;" Style="{StaticResource RibbonSmall}" Click="SortMenu_Click"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{DynamicResource Main.SendReceive}" Style="{StaticResource RibbonGroup}">
                        <Button Content="{DynamicResource Main.SendReceiveAllFolders}" Tag="&#xE895;" Style="{StaticResource RibbonLarge}" Command="{x:Static v:MainWindow.SendReceiveCommand}" ToolTip="F9"/>
                    </HeaderedContentControl>
                </StackPanel>

                <StackPanel Orientation="Horizontal" x:Name="SendReceivePanel" Visibility="Collapsed">
                    <HeaderedContentControl Header="{DynamicResource Main.SendAndReceive}" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource Main.SendReceiveAllFolders}" Tag="&#xE895;" Style="{StaticResource RibbonLarge}" Command="{x:Static v:MainWindow.SendReceiveCommand}"/>
                            <StackPanel VerticalAlignment="Center">
                                <Button Content="{DynamicResource Main.UpdateFolder}" Tag="&#xE72C;" Style="{StaticResource RibbonSmall}" Command="{x:Static v:MainWindow.UpdateFolderCommand}"/>
                                <Button Content="{DynamicResource Main.CancelAll}" Tag="&#xE711;" Style="{StaticResource RibbonSmall}" Command="{x:Static v:MainWindow.CancelSyncCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{DynamicResource Main.Download}" Style="{StaticResource RibbonGroup}">
                        <StackPanel VerticalAlignment="Center">
                            <CheckBox Content="{DynamicResource Main.DownloadFullMessages}" Margin="4" IsChecked="{Binding Settings.DownloadFullMessages}" Click="SaveSettings_Click"/>
                            <CheckBox Content="{DynamicResource Main.MarkAsReadWhenViewed}" Margin="4" IsChecked="{Binding Settings.MarkAsReadWhenViewed}" Click="SaveSettings_Click"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{DynamicResource Main.Preferences}" Style="{StaticResource RibbonGroup}">
                        <ToggleButton Content="{DynamicResource Main.WorkOffline}" Tag="&#xE709;" Style="{StaticResource RibbonLarge}" IsChecked="{Binding WorkOffline}"/>
                    </HeaderedContentControl>
                </StackPanel>

                <StackPanel Orientation="Horizontal" x:Name="FolderPanel" Visibility="Collapsed">
                    <HeaderedContentControl Header="{DynamicResource Main.New}" Style="{StaticResource RibbonGroup}">
                        <Button Content="{DynamicResource Main.NewFolder}" Tag="&#xE8F4;" Style="{StaticResource RibbonLarge}" Command="{x:Static v:MainWindow.NewFolderCommand}"/>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{DynamicResource Main.Actions}" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource Main.RenameFolder}" Tag="&#xE8AC;" Style="{StaticResource RibbonLarge}" Command="{x:Static v:MainWindow.RenameFolderCommand}"/>
                            <StackPanel VerticalAlignment="Center">
                                <Button Content="{DynamicResource Main.DeleteFolder}" Tag="&#xE74D;" Style="{StaticResource RibbonSmall}" Command="{x:Static v:MainWindow.DeleteFolderCommand}"/>
                                <Button Content="{DynamicResource Main.DeleteAll}" Tag="&#xE894;" Style="{StaticResource RibbonSmall}" Command="{x:Static v:MainWindow.EmptyFolderCommand}"/>
                                <Button Content="{DynamicResource Main.MarkAllAsRead}" Tag="&#xE8C3;" Style="{StaticResource RibbonSmall}" Command="{x:Static v:MainWindow.MarkAllReadCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{DynamicResource Main.ImportExport}" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource Main.ImportThunderbird}" Tag="&#xE896;" Style="{StaticResource RibbonLarge}" Command="{x:Static v:MainWindow.ImportThunderbirdCommand}"/>
                            <StackPanel VerticalAlignment="Center">
                                <Button Content="{DynamicResource Main.ImportMboxFile}" Tag="&#xE8E5;" Style="{StaticResource RibbonSmall}" Command="{x:Static v:MainWindow.ImportMboxCommand}"/>
                                <Button Content="{DynamicResource Main.ExportToMbox}" Tag="&#xE898;" Style="{StaticResource RibbonSmall}" Command="{x:Static v:MainWindow.ExportMboxCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{DynamicResource Main.Properties}" Style="{StaticResource RibbonGroup}">
                        <Button Content="{DynamicResource Main.FolderProperties}" Tag="&#xE946;" Style="{StaticResource RibbonLarge}" Command="{x:Static v:MainWindow.FolderPropertiesCommand}"/>
                    </HeaderedContentControl>
                </StackPanel>

                <StackPanel Orientation="Horizontal" x:Name="ViewPanel" Visibility="Collapsed">
                    <HeaderedContentControl Header="{DynamicResource Main.CurrentView}" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource Main.MessagePreview}" Tag="&#xE8FD;" Style="{StaticResource RibbonLarge}" Command="{x:Static v:MainWindow.TogglePreviewCommand}"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{DynamicResource Main.Arrangement}" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource Main.SortByDate}" Tag="&#xE787;" Style="{StaticResource RibbonLarge}" Command="{x:Static v:MainWindow.SortCommand}" CommandParameter="Date"/>
                            <Button Content="{DynamicResource Main.SortByFrom}" Tag="&#xE77B;" Style="{StaticResource RibbonLarge}" Command="{x:Static v:MainWindow.SortCommand}" CommandParameter="From"/>
                            <Button Content="{DynamicResource Main.SortBySubject}" Tag="&#xE8C8;" Style="{StaticResource RibbonLarge}" Command="{x:Static v:MainWindow.SortCommand}" CommandParameter="Subject"/>
                            <Button Content="{DynamicResource Main.SortBySize}" Tag="&#xE9F9;" Style="{StaticResource RibbonLarge}" Command="{x:Static v:MainWindow.SortCommand}" CommandParameter="Size"/>
                            <Button Content="{DynamicResource Main.ReverseSort}" Tag="&#xE8CB;" Style="{StaticResource RibbonLarge}" Command="{x:Static v:MainWindow.ReverseSortCommand}"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{DynamicResource Main.Layout}" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource Main.FolderPane}" Tag="&#xE700;" Style="{StaticResource RibbonLarge}" Command="{x:Static v:MainWindow.ToggleFolderPaneCommand}"/>
                            <Button Content="{DynamicResource Main.ReadingPane}" Tag="&#xE89F;" Style="{StaticResource RibbonLarge}" Click="ReadingPaneMenu_Click"/>
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>

                <StackPanel Orientation="Horizontal" x:Name="HelpPanel" Visibility="Collapsed">
                    <HeaderedContentControl Header="{DynamicResource Main.Help}" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource Main.AboutImvello}" Tag="&#xE946;" Style="{StaticResource RibbonLarge}" Command="{x:Static v:MainWindow.AboutCommand}"/>
                            <Button Content="{DynamicResource Main.DataFolder}" Tag="&#xE8B7;" Style="{StaticResource RibbonLarge}" Command="{x:Static v:MainWindow.OpenDataFolderCommand}"/>
                            <Button Content="{DynamicResource Main.Options}" Tag="&#xE713;" Style="{StaticResource RibbonLarge}" Command="{x:Static v:MainWindow.OptionsCommand}"/>
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
