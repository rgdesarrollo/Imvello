<UserControl x:Class="Imvello.Views.Backstage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBrush}">
    <UserControl.Resources>
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" Padding="24,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TileButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Width" Value="520"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource AccentBrush}">
            <StackPanel>
                <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="14,14,0,18" Padding="8" Click="Back_Click" ToolTip="{DynamicResource Main.Back}">
                    <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" Foreground="{DynamicResource OnAccentBrush}" FontSize="18"/>
                </Button>
                <RadioButton x:Name="InfoNav" Content="{DynamicResource Main.Info}" Style="{StaticResource NavButton}" GroupName="bs" IsChecked="True" Checked="Nav_Checked"/>
                <RadioButton x:Name="OpenNav" Content="{DynamicResource Main.OpenExport}" Style="{StaticResource NavButton}" GroupName="bs" Checked="Nav_Checked"/>
                <RadioButton Content="{DynamicResource Main.Options}" Style="{StaticResource NavButton}" GroupName="bs2" Click="Options_Click"/>
                <RadioButton Content="{DynamicResource Main.About}" Style="{StaticResource NavButton}" GroupName="bs2" Click="About_Click"/>
                <RadioButton Content="{DynamicResource Main.Exit}" Style="{StaticResource NavButton}" GroupName="bs2" Click="Exit_Click"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="40,30,40,30">
                <StackPanel x:Name="InfoPanel">
                    <TextBlock Text="{DynamicResource Main.AccountInformation}" FontSize="28" FontWeight="Light"/>
                    <ComboBox x:Name="AccountBox" SelectionChanged="AccountBox_SelectionChanged" Width="520" HorizontalAlignment="Left" Margin="0,20,0,16" Height="34" VerticalContentAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Email}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource SubtleTextBrush}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="AddAccount_Click" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource OnAccentBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Main.AddAccount}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TileButton}" Click="AccountSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentBrush}" Margin="0,0,16,0"/>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Main.AccountSettings}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Main.AccountSettingsDesc}" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ReconnectTile" Style="{StaticResource TileButton}" Click="ReconnectAccount_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D7;" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentBrush}" Margin="0,0,16,0"/>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Main.ReconnectAccount}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Main.ReconnectAccountDesc}" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TileButton}" Click="SyncAccount_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentBrush}" Margin="0,0,16,0"/>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Main.UpdateAccount}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Main.UpdateAccountDesc}" Foreground="{DynamicResource SubtleTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TileButton}" Click="RemoveAccount_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource DangerBrush}" Margin="0,0,16,0"/>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Main.RemoveAccount}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Main.RemoveAccountDesc}" Foreground="{DynamicResource SubtleTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="StorageText" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,20,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel x:Name="OpenPanel" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Main.OpenExport}" FontSize="28" FontWeight="Light" Margin="0,0,0,20"/>
                    <Button Style="{StaticResource TileButton}" Click="ImportThunderbird_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentBrush}" Margin="0,0,16,0"/>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Main.ImportThunderbirdFolders}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Main.ImportThunderbirdDesc}" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" MaxWidth="440"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TileButton}" Click="ImportMbox_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentBrush}" Margin="0,0,16,0"/>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Main.ImportMboxFile}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Main.ImportMboxDesc}" Foreground="{DynamicResource SubtleTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TileButton}" Click="ExportMbox_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentBrush}" Margin="0,0,16,0"/>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Main.ExportFolderToMbox}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Main.ExportToMboxDesc}" Foreground="{DynamicResource SubtleTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TileButton}" Click="DataFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentBrush}" Margin="0,0,16,0"/>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Main.OpenDataFolder}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Main.OpenDataFolderDesc}" Foreground="{DynamicResource SubtleTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
