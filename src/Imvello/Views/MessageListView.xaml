<UserControl x:Class="Imvello.Views.MessageListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Imvello.Views">
    <UserControl.Resources>
        <Style x:Key="MessageItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <EventSetter Event="MouseDoubleClick" Handler="Item_DoubleClick"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Item_MouseDown"/>
            <EventSetter Event="PreviewMouseMove" Handler="Item_MouseMove"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MessageTemplate">
            <Grid x:Name="root" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="unreadBar" Grid.Column="0" Background="{DynamicResource UnreadBrush}" Visibility="Collapsed" Margin="0,2"/>
                <Border Grid.Column="1" Width="32" Height="32" CornerRadius="16" Background="{Binding AvatarBrush}" VerticalAlignment="Top" Margin="0,8,0,0">
                    <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Grid Grid.Column="2" Margin="0,6,8,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="&#xE8C9;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource DangerBrush}" Margin="4,0,0,0"
                                       Visibility="{Binding IsHighImportance, Converter={StaticResource BoolToVis}}" ToolTip="{DynamicResource Main.HighImportance}"/>
                            <TextBlock Text="&#xE723;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Margin="4,0,0,0"
                                       Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}" ToolTip="{DynamicResource Main.HasAttachments}"/>
                            <Button x:Name="deleteBtn" Style="{StaticResource FlatButton}" Padding="3,1" Margin="4,0,0,0" ToolTip="{DynamicResource Main.Delete}" Visibility="Hidden" Click="DeleteItem_Click">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                            </Button>
                            <Button x:Name="flagBtn" Style="{StaticResource FlatButton}" Padding="3,1" Margin="2,0,0,0" ToolTip="{DynamicResource Main.FlagThisMessage}" Visibility="Hidden" Click="FlagItem_Click">
                                <TextBlock x:Name="flagIcon" Text="&#xE7C1;" Style="{StaticResource Icon}" FontSize="12"/>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="sender" v:SearchHighlighter.Text="{Binding Sender}" v:SearchHighlighter.Pattern="{Binding DataContext.SearchHighlight, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <DockPanel Grid.Row="1">
                        <TextBlock x:Name="date" DockPanel.Dock="Right" Text="{Binding DateText}" FontSize="11.5" Foreground="{DynamicResource SubtleTextBrush}" Margin="8,0,0,0"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="&#xE97A;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,4,0" Foreground="{DynamicResource SubtleTextBrush}"
                                       Visibility="{Binding IsAnswered, Converter={StaticResource BoolToVis}}" ToolTip="{DynamicResource Main.YouReplied}"/>
                            <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,4,0" Foreground="{DynamicResource SubtleTextBrush}"
                                       Visibility="{Binding IsForwarded, Converter={StaticResource BoolToVis}}" ToolTip="{DynamicResource Main.YouForwarded}"/>
                        </StackPanel>
                        <TextBlock x:Name="subject" v:SearchHighlighter.Text="{Binding Subject}" v:SearchHighlighter.Pattern="{Binding DataContext.SearchHighlight, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Grid.Row="2" x:Name="preview" Text="{Binding Preview}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding DataContext.ShowPreview, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRead}" Value="False">
                    <Setter TargetName="unreadBar" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="sender" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="subject" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="subject" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                    <Setter TargetName="date" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                    <Setter TargetName="date" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                    <Setter TargetName="flagBtn" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="flagIcon" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                    <Setter TargetName="flagIcon" Property="Text" Value="&#xEB4B;"/>
                    <Setter TargetName="root" Property="Background" Value="{DynamicResource InfoBackgroundBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=root}" Value="True">
                    <Setter TargetName="flagBtn" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="deleteBtn" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,6,6,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource FlatButton}" Click="SortButton_Click" ToolTip="{DynamicResource Main.Sort}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SortText" Foreground="{DynamicResource SubtleTextBrush}"/>
                            <TextBlock x:Name="SortArrow" Text="&#xE74B;" Style="{StaticResource Icon}" FontSize="10" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="AllTab" Content="{DynamicResource Main.All}" Style="{StaticResource FlatButton}" Padding="8,3" GroupName="flt" IsChecked="True" Checked="Filter_Checked" Tag="All"/>
                    <RadioButton Content="{DynamicResource Main.UnreadFilter}" Style="{StaticResource FlatButton}" Padding="8,3" GroupName="flt" Checked="Filter_Checked" Tag="Unread"/>
                    <RadioButton Content="{DynamicResource Main.Flagged}" Style="{StaticResource FlatButton}" Padding="8,3" GroupName="flt" Checked="Filter_Checked" Tag="Flagged"/>
                    <TextBlock Text="{Binding ListTitle}" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SubtleTextBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ListBox x:Name="List" Grid.Row="1" BorderThickness="0" SelectionMode="Extended"
                 ItemContainerStyle="{StaticResource MessageItemStyle}" ItemTemplate="{StaticResource MessageTemplate}"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="List_SelectionChanged" KeyDown="List_KeyDown" ScrollViewer.ScrollChanged="List_ScrollChanged"
                 ContextMenuOpening="List_ContextMenuOpening">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource ControlBrush}" Padding="10,8,0,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ContextMenu>
                <ContextMenu/>
            </ListBox.ContextMenu>
        </ListBox>

        <TextBlock Grid.Row="1" Text="{DynamicResource Main.EmptyList}" HorizontalAlignment="Center" Margin="0,60,0,0"
                   Foreground="{DynamicResource SubtleTextBrush}" x:Name="EmptyText" Visibility="Collapsed"/>
    </Grid>
</UserControl>
